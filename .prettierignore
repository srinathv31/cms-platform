# Prettier also skips what .gitignore lists; the first groups repeat it so editors and other tools agree.

# Build and tool output: regenerated by Next.js, Vitest and Playwright, never edited.
/.next/
/out/
/build/
/coverage/
/.vitest/
/test-results/
/playwright-report/
/blob-report/
/e2e/__screens__/
*.tsbuildinfo
next-env.d.ts

# Local data: the SQLite files and the uploads folder.
/data/

# Dependencies and lockfile: installed and written by npm.
/node_modules/
package-lock.json

# Byte-exact fixtures: tests read these from disk and compare them as text with what the code produces. The render
# goldens are the Java engine's acceptance test and must stay byte for byte; the paste, import and Unicode files
# are real clipboard HTML, real documents and the Unicode Consortium's data.
/src/server/render/golden/cases/
/src/editor/paste/__fixtures__/
/e2e/fixtures/import/
/src/domain/messages/GraphemeBreakTest.txt

# Generated code: shadcn components (added with `npx shadcn add`, never hand-edited) and Drizzle's migrations and
# snapshots (written by `npm run db:generate`; tests read the .sql files and split them on
# "--> statement-breakpoint").
/src/components/ui/
/src/server/db/migrations/

# Files other tools write or own: the agent skills (and the symlinks to them) and their lock file.
/.agents/
/.claude/
/skills-lock.json

# Frozen documents: dated snapshots that are never edited.
/docs/archive/
/docs/quality-review-2026-10-12.md
/docs/quality-review-2026-10-12/
